# ──────────────────────────────────────────────
# 이 파일을 복사해서 .env 로 만들고 값을 채우세요.
#   cp .env.example .env
# ──────────────────────────────────────────────

# Anthropic (캡션/해시태그 생성)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (DALL·E 이미지 생성)
OPENAI_API_KEY=sk-...

# Instagram Graph API
# - 인스타 "비즈니스" 또는 "크리에이터" 계정이 Facebook 페이지에 연결되어 있어야 합니다.
# - IG_USER_ID: 인스타그램 비즈니스 계정 ID (페이지에 연결된 IG 계정 ID)
# - IG_ACCESS_TOKEN: instagram_content_publish, pages_read_engagement 등 권한이 포함된 장기 토큰
IG_USER_ID=1784xxxxxxxxxxx
IG_ACCESS_TOKEN=EAAG...

# Graph API 버전 (선택)
GRAPH_API_VERSION=v21.0
