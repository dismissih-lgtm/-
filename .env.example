# ──────────────────────────────────────────────
# 이 파일을 복사해서 .env 로 만들고 값을 채우세요.
#   cp .env.example .env
# ──────────────────────────────────────────────

# Anthropic (캡션/해시태그 생성)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (DALL·E 이미지 생성)
OPENAI_API_KEY=sk-...

# ── 전송 대상 선택 ──
# 카카오톡으로 받기만 한다면 아래 Instagram 항목은 비워 둬도 됩니다.

# 카카오톡 '나에게 보내기' (페이스북/인스타 없이 사용 가능)
# get_kakao_token.py 로 발급:  python get_kakao_token.py --rest-api-key <REST_API_KEY>
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=

# Instagram Graph API (자동 업로드를 쓸 때만 필요)
# - 인스타 "비즈니스/크리에이터" 계정이 Facebook 페이지에 연결되어 있어야 합니다.
# - get_credentials.py 로 발급
IG_USER_ID=
IG_ACCESS_TOKEN=

# Graph API 버전 (선택)
GRAPH_API_VERSION=v21.0

# 뉴스 검색어 (선택) - 원하는 주제/카테고리로 변경 가능
# 예: "오늘의 IT 기술 뉴스", "오늘의 스포츠 뉴스"
NEWS_QUERY=오늘의 한국 주요 뉴스 헤드라인
